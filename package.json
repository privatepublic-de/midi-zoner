{
  "name": "midi-zoner",
  "version": "1.2.0",
  "description": "Play multiple MIDI devices, channels and note ranges from one MIDI input source. Includes an arpeggiator with euclidian patterns and CC controllers.",
  "main": "dist/main/main.js",
  "scripts": {
    "start": "npm run build:ts && electron .",
    "dev": "concurrently \"npm run watch\" \"sleep 3 && electron .\"",
    "watch": "tsc --watch",
    "build:ts": "tsc",
    "check:chords": "tsc && node scripts/chords-check.mjs --against scripts/chords-baseline.json",
    "check:loops": "tsc && node scripts/loop-window-check.cjs",
    "check:app": "tsc && node scripts/app-check.mjs",
    "icon": "node build/icon-gen.mjs && electron build/make-icon.cjs",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "pack:osx": "npm run build:ts && electron-packager . --out=dist/osx --platform=darwin --arch=x64 --icon='./assets/zoner.icns' --overwrite --ignore='src|assets'",
    "pack:osx:arm": "npm run build:ts && electron-packager . --out=dist/osx --platform=darwin --arch=arm64 --icon='./assets/zoner.icns' --overwrite --ignore='src|assets' && codesign --force --deep --sign - 'dist/osx/midi-zoner-darwin-arm64/midi-zoner.app'",
    "build:win": "npm run build:ts && electron-builder -w",
    "build:mac": "npm run build:ts && electron-builder -m",
    "build:linux": "npm run build:ts && electron-builder -l",
    "build:all": "npm run build:win && npm run build:mac && npm run build:linux && npm run pack:osx"
  },
  "author": "Peter Witzel - privatepublic.de",
  "license": "ISC",
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^25.0.3",
    "concurrently": "^10.0.3",
    "electron": "^42.11.16",
    "electron-builder": "^26.15.3",
    "rimraf": "^6.1.2",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "de.privatepublic.midizoner",
    "productName": "midi-zoner",
    "files": [
      "dist/**/*",
      "res/**/*",
      "index.html",
      "styles.css"
    ],
    "mac": {
      "target": "dmg",
      "icon": "assets/zoner.icns",
      "category": "public.app-category.music"
    },
    "win": {
      "target": "portable",
      "icon": "assets/zoner.png"
    },
    "linux": {
      "target": "AppImage",
      "category": "AudioVideo"
    }
  },
  "dependencies": {
    "electron-settings": "3.2.0",
    "source-map": "^0.7.6"
  },
  "overrides": {
    "@electron/universal": {
      "minimatch": "^11.0.8"
    },
    "app-builder-lib": {
      "minimatch": "^11.0.8"
    }
  }
}
